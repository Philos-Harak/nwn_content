//////////////////////////////////////////////////////////////////////////////////////////////////////
// Name: ac_0_tent
/*////////////////////////////////////////////////////////////////////////////////////////////////////

 Activate item script for tent.
 Used to create a placeable tent.

*/////////////////////////////////////////////////////////////////////////////////////////////////////
// Made By: Philos
// Made On: 3/25/15
//////////////////////////////////////////////////////////////////////////////////////////////////////

#include "0i_master"

void main()
{
   string sTag;
   location lLocation = GetLocalLocation (OBJECT_SELF, "0_location");
   object oItem = GetLocalObject (OBJECT_SELF, "0_item");
   // Get the tag of the item used this is the same as the placeable resref.
   sTag = GetTag (oItem);
   // create fire at location.
   CreateObject (OBJECT_TYPE_PLACEABLE, sTag, lLocation);
   // Remove the item.
   DestroyObject (oItem);
}
