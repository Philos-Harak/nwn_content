/*////////////////////////////////////////////////////////////////////////////////////////////////////
 Script Name: 0e_closetreasure
 Programmer: Philos
//////////////////////////////////////////////////////////////////////////////////////////////////////
 Runs the script for closing a treasure pile.
 Checks to see if all the treasure has been taken.
 If so it removes the treasure pile.
*/////////////////////////////////////////////////////////////////////////////////////////////////////
void main()
{
   object oItem = GetFirstItemInInventory ();
   if (oItem == OBJECT_INVALID) DestroyObject (OBJECT_SELF);
}

