/*/////////////////////////////////////////////////////////////////////////////////////////////////////
 Script Name: ac_players_book
 Programmer: Philos
///////////////////////////////////////////////////////////////////////////////////////////////////////
 Activate item script for players book.
 This opens a conversation so a player can see all of the servers rules.
*//////////////////////////////////////////////////////////////////////////////////////////////////////

#include "0i_master"

void main()
{
    object oPC = GetItemActivator ();
    // Open up the book.
    ActionStartConversation (oPC, "co_dm_guide", TRUE, FALSE);
}
