/*//////////////////////////////////////////////////////////////////////////////
 Script: 0c_opendoor
 Programmer: Philos
////////////////////////////////////////////////////////////////////////////////
    Has the NPC open the nearest door.
*///////////////////////////////////////////////////////////////////////////////
void main()
{
    object oDoor = GetNearestObject (OBJECT_TYPE_DOOR);
    if (GetLocked (oDoor)) SetLocked (oDoor, FALSE);
    ActionOpenDoor (oDoor);
}
