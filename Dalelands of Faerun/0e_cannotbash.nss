/*////////////////////////////////////////////////////////////////////////////////////////////////////
 Script Name: 0e_cannotbash
 Programmer: Philos
//////////////////////////////////////////////////////////////////////////////////////////////////////
 Event that fires when someone bashes a door, it tells them that this door cannot be bashed open.
*/////////////////////////////////////////////////////////////////////////////////////////////////////
#include "0i_s_message"
void main ()
{
   object oPC = GetLastDamager (OBJECT_SELF);
   // Send the message.
   SendMessages ("This door is held fast by a strong mechanism and can not be bashed open!", COLOR_RED, oPC, FALSE, FALSE);
}

