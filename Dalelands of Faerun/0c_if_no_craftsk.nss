/////////////////////////////////////////////////////////////////////////////////////////////////////
 Conversation script that checks to see if they can change their item's appearance based on craft skill.
*/////////////////////////////////////////////////////////////////////////////////////////////////////
#include "0i_items"

int StartingConditional()
{
    int iResult;
    // Make sure they can use Craft skill (23).
    if (GetSkillRank (23, GetPCSpeaker(), TRUE) == 0) return TRUE;
    return FALSE;
}
