////////////////////////////////////////////////////////////////////////////////
 Text Appears When script that checks if the PCSpeaker is a DM or DM possessed
 creature.
*///////////////////////////////////////////////////////////////////////////////
#include "0i_master"
int StartingConditional()
{
    object oPC = GetPCSpeaker();
    if(GetIsDungeonMaster(oPC)) return TRUE;
    return FALSE;
}
