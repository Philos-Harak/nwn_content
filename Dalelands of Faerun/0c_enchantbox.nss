/*//////////////////////////////////////////////////////////////////////////////
 Script: 0c_enchantbox
 Programmer: Philos
////////////////////////////////////////////////////////////////////////////////
 Actions Taken script that enchants an item at the selected level.
 Param:
 nLevel - the level of the enchantment.
/*//////////////////////////////////////////////////////////////////////////////
#include "0i_crafting"
void main()
{
    int nLevel = StringToInt (GetScriptParam ("nLevel"));
    EnchantBox (OBJECT_SELF, nLevel);
}
