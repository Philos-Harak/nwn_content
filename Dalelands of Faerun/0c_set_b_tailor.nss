/*//////////////////////////////////////////////////////////////////////////////
 Script: 0c_set_b_tailor
 Programmer: Philos
////////////////////////////////////////////////////////////////////////////////
 Text Appears When script that sets the body tailor to the PC's appearance type.
*///////////////////////////////////////////////////////////////////////////////
int StartingConditional()
{
    object oPC = GetPCSpeaker ();
    SetCreatureAppearanceType (OBJECT_SELF, GetAppearanceType (oPC));
    return TRUE;
}
