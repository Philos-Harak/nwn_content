/*//////////////////////////////////////////////////////////////////////////////
 Script: 0c_take_gold
 Programmer: Philos
////////////////////////////////////////////////////////////////////////////////
 Actions Taken script that takes gold from a PC.
 Param:
 nGold - the amount of gold to be taken.
*///////////////////////////////////////////////////////////////////////////////
void main()
{
    object oPC = GetPCSpeaker ();
    int nGold = StringToInt (GetScriptParam ("nGold"));
    TakeGoldFromCreature (nGold, oPC);
}
