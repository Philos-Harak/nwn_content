//////////////////////////////////////////////////////////////////////////////////////////////////////
// Name: 0c_if_queststart
/*////////////////////////////////////////////////////////////////////////////////////////////////////

 Conversation script that checks to see if they have started an NPC's quest.

*/////////////////////////////////////////////////////////////////////////////////////////////////////
// Made By: Philos
//////////////////////////////////////////////////////////////////////////////////////////////////////

#include "0i_creature"

int StartingConditional()
{
    int iJournal;
    string sJournalTag;
    object oPC = GetPCSpeaker ();
    sJournalTag = "0_Journal_" + GetLocalString (OBJECT_SELF, "0_Journal");
    iJournal = GetLocalInt (oPC, "NW_JOURNAL_ENTRY" + sJournalTag);
    if (iJournal > 0) return TRUE;
    return FALSE;
}
